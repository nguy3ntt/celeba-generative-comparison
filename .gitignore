!runs/vae/.gitkeep
!runs/dcgan/.gitkeep
!runs/diffusion/.gitkeep

# Large outputs
outputs/generated_samples/*
outputs/reconstructions/*
outputs/latent_interpolations/*
outputs/nearest_neighbors/*
