# Virtual environments
.venv/
venv/
env/

# Environment variables
.env

# Raw and processed datasets
data/raw/*
data/interim/*
data/processed/*

# Keep folder placeholders
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Keep dataset instruction file
!data/README.md


# Model checkpoints
checkpoints/*
*.pt
*.pth
*.ckpt
*.safetensors

# Keep checkpoint folder placeholder
!checkpoints/.gitkeep


# Training logs
runs/*
wandb/
logs/
lightning_logs/

